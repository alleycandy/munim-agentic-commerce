# Copy to .env (or export these) before running the app.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/munim
SPRING_DATASOURCE_USERNAME=munim
SPRING_DATASOURCE_PASSWORD=munim

# Optional. Without this, POST /api/sessions/{id}/chat returns
# {"ok":false,"error":"..."} and you should use the
# POST /api/sessions/{id}/demo/hotel-breakfast endpoint instead - it drives
# the same money engine with a recorded script, no key required.
XAI_API_KEY=

PORT=8080
